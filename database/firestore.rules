    match /services/{id} {
      allow read: if signedIn();
      allow create, update: if isStaff()
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.price is number
          && request.resource.data.price >= 0
          && request.resource.data.isActive is bool;
      allow delete: if isStaff();
    }

    match /requests/{id} {
      function validNewRequest(d) {
        return d.status == 'Pending'
            && d.employeeId == null
            && d.hasFeedback == false
            && d.customerId == request.auth.uid
            && d.refNumber is string && d.refNumber.matches('^PMA-[A-Z0-9]{4,20}$')
            && d.serviceId is string
            && d.serviceName is string
            && d.requestedDate is string
            && d.requestedDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && d.requestedTime is string
            && d.requestedTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
            && d.siteAddress is string
            && d.siteAddress.size() >= 8 && d.siteAddress.size() <= 200;
      }

      function identityUnchanged() {
        return request.resource.data.customerId == resource.data.customerId
            && request.resource.data.refNumber == resource.data.refNumber;
      }

      function staffMayUpdate() {
        return isStaff() && (
            (resource.data.status == 'Pending'
              && request.resource.data.status in ['Approved', 'Rejected'])
         || (resource.data.status == 'Approved'
              && request.resource.data.status == 'Approved'));
      }

      function employeeMayUpdate() {
        return isEmployee()
            && resource.data.employeeId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && ((resource.data.status == 'Approved' && request.resource.data.status == 'In Progress')
             || (resource.data.status == 'In Progress' && request.resource.data.status == 'Completed'));
      }

      function customerMayFlagFeedback() {
        return isCustomer()
            && resource.data.customerId == request.auth.uid
            && resource.data.status == 'Completed'
            && resource.data.hasFeedback == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hasFeedback'])
            && request.resource.data.hasFeedback == true;
      }

