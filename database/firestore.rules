<<<<<<< HEAD
      // Recipients read their own; staff also read the shared admin feed.
      allow read: if signedIn() && (resource.data.recipientId == request.auth.uid
          || isStaff());
      allow create: if signedIn();
      allow update: if signedIn() && (isStaff()
          || (resource.data.recipientId == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])));
      allow delete: if false;
    }

    // Admin accounts — mirrors the old MySQL `admins` table.
    // The matching users/{uid} doc (role 'staff') is what actually
    // grants access; this collection adds main/sub-admin metadata.
    match /admins/{uid} {
      allow read: if isStaff();
      // Bootstrap: a staff member can create their own admin record
      // (first main_admin). Additional admins are created by a main admin.
      allow create: if isStaff() && (request.auth.uid == uid || isMainAdmin());
      // Main admin manages accounts. Each admin may edit their own
      // profile and clear firstLogin after the forced password change,
      // but may never change their role, active flag or creator.
      allow update: if isMainAdmin()
          || (isStaff() && request.auth.uid == uid
              && request.resource.data.adminRole == resource.data.adminRole
              && request.resource.data.isActive == resource.data.isActive
              && request.resource.data.createdBy == resource.data.createdBy);
      allow delete: if isMainAdmin();
    }

    // Website contact form — anyone (even signed out) may submit;
    // only staff may read the inbox.
    match /contact_messages/{id} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'message']);
      allow read, update, delete: if isStaff();
    }
